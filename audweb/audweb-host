#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""LibreWolf's side of audweb: the browser extension's native messaging host.

The browser starts it for each message and talks to it on stdin and stdout:
a 32-bit length in the machine's byte order, then that many bytes of JSON.

The extension sends {"url": URL, "time": SECONDS, "playing": BOOL,
"next": [URL...]}: the track the tab plays, where it is in it, whether it is
moving on, and where what the site plays after it comes from (its playlist,
queue, or autoplay). This runs `audweb -t SECONDS [-c] URL` and answers
once Audacious plays there: {"ok": true}, or {"ok": false, "error": TEXT}.
The extension pauses the tab on the answer, so for a while both play the
same thing, at the same place, and then only Audacious does.

Then, left running after the answer, `audweb -e -n MAX -a URL NEXT...` adds
what comes next behind it, in its own time (SoundCloud's tracks are
downloaded one by one); its messages go to ~/.cache/audweb/next.log.
The last message itself is kept in ~/.cache/audweb/host.log.
"""

import json
import os
import shutil
import signal
import struct
import subprocess
import sys

# SoundCloud downloads the track first, which has taken up to 30 s.
TIMEOUT = 120
# Tracks added after the first: about 3 hours, all downloaded (1 MB or so
# a minute) while the first plays.
NEXT_MAX = 50


def read_message():
    raw = sys.stdin.buffer.read(4)
    if len(raw) < 4:
        return None
    (n,) = struct.unpack("=I", raw)
    return json.loads(sys.stdin.buffer.read(n))


def send_message(msg):
    data = json.dumps(msg).encode()
    sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
    sys.stdout.buffer.flush()


def audweb():
    # The one installed next to this script first, so that a copy run from
    # the source tree runs its own audweb.
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "audweb")
    if os.access(here, os.X_OK):
        return here
    return shutil.which("audweb") or "audweb"


def cache_dir():
    d = os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "audweb")
    os.makedirs(d, exist_ok=True)
    return d


def stop_next():
    """Stops the tracks of an earlier hand-over still being added."""
    path = os.path.join(cache_dir(), "next.pid")
    try:
        with open(path) as f:
            pgid = int(f.read())
        os.remove(path)
        # Only if it is still audweb, and not a new process with its number.
        with open(f"/proc/{pgid}/cmdline", "rb") as f:
            if b"audweb" not in f.read():
                return
        # Its own session: the process group is audweb's, with its yt-dlp.
        os.killpg(pgid, signal.SIGTERM)
    except (OSError, ValueError):
        pass


def log(msg):
    """What the last hand-over was, in ~/.cache/audweb/host.log."""
    try:
        with open(os.path.join(cache_dir(), "host.log"), "w") as f:
            json.dump(msg, f, indent=1)
            f.write("\n")
    except OSError:
        pass


def handle(msg):
    log(msg)
    url = msg.get("url")
    if not isinstance(url, str) or not url.startswith(("https://", "http://")):
        return {"ok": False, "error": "no http(s) URL in the message"}
    try:
        time = max(0.0, float(msg.get("time") or 0))
    except (TypeError, ValueError):
        return {"ok": False, "error": "time is not a number"}
    stop_next()
    cmd = [audweb(), "-t", f"{time:.2f}"]
    if msg.get("playing"):
        cmd.append("-c")
    # "--": a URL is never taken for an option.
    cmd += ["--", url]
    try:
        r = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=TIMEOUT,
            # audweb may start Audacious, which must outlive this host:
            # the browser kills the host's process group when it is done.
            start_new_session=True,
        )
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"audweb took more than {TIMEOUT} s"}
    except OSError as e:
        return {"ok": False, "error": f"cannot run audweb: {e}"}
    err = r.stderr.decode(errors="replace").strip()
    if r.returncode != 0:
        return {"ok": False, "error": err or f"audweb exited with {r.returncode}"}
    nxt = [u for u in msg.get("next") or []
           if isinstance(u, str) and u.startswith(("https://", "http://"))]
    if nxt:
        add_next(url, nxt)
    return {"ok": True}


def add_next(url, nxt):
    cache = cache_dir()
    with open(os.path.join(cache, "next.log"), "w") as log:
        p = subprocess.Popen(
            [audweb(), "-e", "-n", str(NEXT_MAX), "-a", url, "--", *nxt],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            # Outlives this host, which exits once it has answered.
            start_new_session=True,
        )
    with open(os.path.join(cache, "next.pid"), "w") as f:
        f.write(str(p.pid))


def main():
    msg = read_message()
    if msg is None:
        return
    send_message(handle(msg))


if __name__ == "__main__":
    main()
