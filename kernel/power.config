# wmutils: installed as /etc/kernel/config.d/wmutils-power.config
# by kernel/install.sh. sys-kernel/asahi-kernel merges it, like trim.config,
# on top of the Fedora-based dist-kernel config.
#
# Three options the stock config leaves off, so that an idle machine wakes
# its CPUs less often and they stay powered down longer. They are generic
# kernel options written for battery-powered devices (lazy RCU came from
# ChromeOS and Android) and touch no Apple driver. See kernel/README.md for
# how to check them after booting and how to switch them off for one boot.

# Work items queued on "power efficient" workqueues run on whichever CPU is
# awake instead of waking the CPU that queued them. The same as booting
# with workqueue.power_efficient=1.
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# RCU callbacks run in kernel threads, which the scheduler puts on a CPU
# that is awake, instead of in each CPU's own softirq. The same as booting
# with rcu_nocbs=all. RCU_LAZY works only on CPUs set up this way.
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y

# Callbacks that are in no hurry wait up to ten seconds for a grace period
# they can share, instead of each starting one (and its timer ticks) at
# once. Memory pressure or a long callback list ends the wait early.
CONFIG_RCU_LAZY=y
